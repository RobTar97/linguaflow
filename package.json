{
  "name": "linguaflow",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source English, Polish, and Japanese conversation practice for learners and teachers.",
  "license": "MIT",
  "keywords": [
    "language-learning",
    "conversation-practice",
    "education",
    "cloudflare-workers",
    "react"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run preview:cloudflare",
    "preview:static": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run check && wrangler deploy",
    "types:worker": "tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1",
    "check": "npm run lint && npm run test && npm run build && npm run types:worker",
    "check:content": "vitest run --maxWorkers=1 src/catalog/topicCatalog.test.ts"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.112.0"
  }
}
