{
  "name": "linguaflow",
  "private": true,
  "version": "0.5.0",
  "description": "Open-source English, Polish, and Japanese conversation practice for learners and teachers.",
  "license": "MIT",
  "keywords": [
    "language-learning",
    "conversation-practice",
    "education",
    "cloudflare-workers",
    "react"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run preview:cloudflare",
    "preview:static": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run check:deploy && npm run check && wrangler deploy",
    "types:worker": "tsc -p tsconfig.worker.json",
    "check:worker-config": "node scripts/check-worker-config.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1",
    "audit:secrets": "node scripts/check-secrets.mjs",
    "audit:seo": "node scripts/check-seo-output.mjs",
    "audit:performance": "node scripts/check-performance-budget.mjs",
    "check:deploy": "node scripts/check-deploy-config.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "check": "npm run audit:secrets && npm run lint && npm run test && npm run build && npm run audit:seo && npm run audit:performance && npm run types:worker && npm run check:worker-config && npm run test:worker",
    "check:content": "vitest run --maxWorkers=1 src/catalog/topicCatalog.test.ts",
    "pack:validate": "tsx scripts/topic-pack.ts validate",
    "pack:build": "tsx scripts/topic-pack.ts build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.3.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  }
}
